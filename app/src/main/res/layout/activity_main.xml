<?xml version="1.0" encoding="utf-8"?>
<!-- Home Screen Layout -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_eco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Logo / Icon -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/ic_launcher_foreground"
            android:elevation="8dp"
            android:contentDescription="NammaHasiru Logo" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namma Hasiru"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/green_dark"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.05" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Plantation Tracker"
            android:textSize="18sp"
            android:textColor="@color/green_medium"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="48dp" />

        <!-- Navigation Cards -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAddPlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:contentPadding="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🌱"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/btn_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Plant"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark"
                    android:layout_marginStart="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewPlants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:contentPadding="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🌳"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/btn_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View My Plants"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark"
                    android:layout_marginStart="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:contentPadding="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="📊"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/btn_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Survival Dashboard"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark"
                    android:layout_marginStart="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlantMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:contentPadding="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="📍"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/btn_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plant Map (Surroundings)"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_dark"
                    android:layout_marginStart="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plant trees. Track life. 🌍"
            android:textSize="14sp"
            android:textColor="@color/green_medium"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>
