<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.nammahasiru">

    <!-- ═══ PERMISSIONS ═══════════════════════════════════════════════════ -->

    <!-- Camera for taking plant photos -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- GPS Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage for saving photos (Android < 10) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Internet and Network State for Google Maps -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ═══ APPLICATION ══════════════════════════════════════════════════ -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NammaHasiru">

        <!-- MainActivity: The home/launch screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AddPlantActivity -->
        <activity android:name=".AddPlantActivity" android:exported="false" />

        <!-- ViewPlantsActivity -->
        <activity android:name=".ViewPlantsActivity" android:exported="false" />

        <!-- DashboardActivity -->
        <activity android:name=".DashboardActivity" android:exported="false" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCgg0GCLbndA4WL7lkY6m-Fj2r4OIdyVh4" />

        <!-- MapActivity -->
        <activity android:name=".MapActivity" android:exported="false" />

        <!-- LocationPickerActivity -->
        <activity android:name=".LocationPickerActivity" android:exported="false" />

        <!-- FileProvider for camera photo sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.nammahasiru.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>